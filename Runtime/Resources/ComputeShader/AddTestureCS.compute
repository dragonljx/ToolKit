#pragma kernel CSMain


Texture2D<float4> FrontBuffer;
Texture2D<float4> BackBuffer;

RWTexture2D<float4> Result;


uint width;
uint height;

int offsetX;
int offsetY;


[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= width || id.y >= height)
    {
        return;
    }


    int2 backPos = int2(id.xy);


    float4 backColor = BackBuffer[backPos];


    int frontWidth;
    int frontHeight;

    FrontBuffer.GetDimensions(
        frontWidth,
        frontHeight
    );


    int2 frontPos = int2(
        id.x - offsetX,
        id.y - offsetY
    );


    float4 result = backColor;


    if (frontPos.x >= 0 &&
        frontPos.y >= 0 &&
        frontPos.x < frontWidth &&
        frontPos.y < frontHeight)
    {
        float4 frontColor =
            FrontBuffer[frontPos];


        result = lerp(
            backColor,
            frontColor,
            frontColor.a
        );
    }


    Result[backPos] = result;
}